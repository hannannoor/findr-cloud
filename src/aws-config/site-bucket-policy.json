{
  "Version": "2012-10-17",
  "Id": "FindrSiteBucketPolicy",
  "Statement": [
    {
      "Sid": "AllowPublicReadOfWebsiteFilesOnly",
      "Effect": "Allow",
      "Principal": "*",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::findr-site-XXXXXXXX/*"
    },
    {
      "Sid": "DenyAnyRequestNotUsingHTTPS",
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:*",
      "Resource": [
        "arn:aws:s3:::findr-site-XXXXXXXX",
        "arn:aws:s3:::findr-site-XXXXXXXX/*"
      ],
      "Condition": {
        "Bool": {
          "aws:SecureTransport": "false"
        }
      }
    }
  ]
}
